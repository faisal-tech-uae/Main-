NODE_ENV=development
PORT=4000

# Postgres connection string used by Prisma (packages/db)
DATABASE_URL="postgresql://resumeai:resumeai@localhost:5432/resumeai_pro"

# Clerk (https://dashboard.clerk.com) — used to verify session tokens and
# sync users. CLERK_WEBHOOK_SECRET is the signing secret for the
# /webhooks/clerk endpoint (Svix signature verification).
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=

WEB_APP_URL="http://localhost:3000"

# At least one AI provider key is required. AI_PROVIDER picks which one to
# prefer when multiple are configured (defaults to OPENAI, then ANTHROPIC,
# then GEMINI).
AI_PROVIDER=OPENAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
